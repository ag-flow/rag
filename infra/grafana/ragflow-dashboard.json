{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Datasource Loki (log.yoops.org / 192.168.10.164)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["ragflow"],
  "title": "ragflow — observabilité",
  "uid": "ragflow-min",
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "host",
        "type": "query",
        "datasource": "${DS_LOKI}",
        "query": "label_values(host)",
        "current": { "text": "rag-dev", "value": "rag-dev" },
        "refresh": 2,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Volume de logs par niveau",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "sum by (level) (count_over_time({host=\"$host\", job=\"ragflow\"} | json | level != `` [$__interval]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erreurs (fenêtre)",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "sum(count_over_time({host=\"$host\", job=\"ragflow\"} | json | level=`error` [$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jobs terminés (fenêtre)",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "sum(count_over_time({host=\"$host\", job=\"ragflow\"} | json | event=`sync.executor.job_done` [$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jobs d'indexation par statut",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "sum by (status) (count_over_time({host=\"$host\", job=\"ragflow\"} | json | event=`push_job.done` [$__interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Échecs de pipeline (enrichissement, persistance, rebuild lexical)",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "sum by (event) (count_over_time({host=\"$host\", job=\"ragflow\"} | json | event=~`sync.executor.enrichment_failed|sync.executor.job_files_persist_failed|sync.rebuild_lexical.failed|.*payload_cleanup_failed` [$__interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Activité recherche MCP",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "sum by (event) (count_over_time({host=\"$host\", job=\"ragflow\"} | json | event=~`mcp_standard.search|mcp_standard.search_files|mcp_standard.get_document` [$__interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Erreurs récentes",
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "datasource": "${DS_LOKI}",
          "expr": "{host=\"$host\", job=\"ragflow\"} | json | level=`error`"
        }
      ]
    }
  ]
}
