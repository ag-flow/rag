# Caddyfile dev — reverse proxy HTTP minimal pour env de dev (LXC ou local).
# /api/*  → backend:8000 (FastAPI)
# /auth/* → backend:8000 (OIDC flow M5a)
# /me     → backend:8000 (OIDC)
# /ws/*   → backend:8000 (WebSocket logs jobs)
# /mcp*   → backend:8000 (endpoint MCP, POST + mount ASGI /mcp/{workspace_id})
# /.well-known/oauth-protected-resource* → backend:8000 (métadonnées MCP, RFC 9728)
# /ui*    → frontend:80 (Nginx static, M5b)
# /health → backend:8000 (smoke direct)
# /version → backend:8000 (smoke direct)
# /       → redirect vers /ui
#
# Pas de TLS — Cloudflare Tunnel gère le HTTPS en front en prod.

{
    auto_https off
}

:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /auth/* {
        reverse_proxy backend:8000
    }
    handle /me {
        reverse_proxy backend:8000
    }
    handle /ws/* {
        reverse_proxy backend:8000
    }
    handle /mcp* {
        reverse_proxy backend:8000
    }
    # Métadonnées de ressource protégée de /mcp (RFC 9728) : sans elles, un
    # client MCP ne découvre pas le serveur d'autorisation et ne peut pas
    # obtenir de jeton. Préfixe précis : le reste de /.well-known n'est pas à nous.
    handle /.well-known/oauth-protected-resource* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    handle /version {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /redoc* {
        reverse_proxy backend:8000
    }
    handle /ui* {
        reverse_proxy frontend:80
    }
    handle / {
        redir * /ui permanent
    }
    handle {
        respond "ag-flow.rag — see /ui or /api/*" 200
    }
}
