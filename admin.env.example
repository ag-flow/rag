# admin.env — réglages d'auth pilotés par l'IHM (gérés par le backend)
#
# Ce fichier est écrit par l'application quand tu saisis le client secret OIDC
# ou (dés)actives la connexion locale depuis /ui/settings/oidc-config. Il est
# relu à CHAUD (aucun redémarrage nécessaire) et reste éditable à la main sur
# l'hôte — c'est le recours break-glass si tu es verrouillé hors de l'IHM.
#
# Distinct du .env principal : celui-ci ne porte QUE ces réglages, jamais la
# master key ni les secrets DB.
#
# En dev/prod, ce fichier vit dans le volume monté (défaut /app/data/admin.env).
# Copie-le au bon endroit avant le premier `up` si tu veux préseeder des valeurs.

# Client secret du client OIDC (Keycloak). Vide/absent ⇒ l'échange OIDC échoue
# avec une erreur explicite tant qu'il n'est pas renseigné.
RAG_OIDC_CLIENT_SECRET=

# Désactive la connexion locale (username/mot de passe) — ne laisse que le SSO.
# ABSENT ⇒ connexion locale ACTIVÉE. Mettre `true` pour la désactiver.
RAG_LOCAL_AUTH_DISABLED=false
