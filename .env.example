# Configuration ag-flow.rag — dev/test (M1)
# Spec : docs/superpowers/specs/2026-05-14-rag-mvp-implementation-design.md

# ─── PostgreSQL (base rag_config) ───────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag_config
DATABASE_URL=postgresql://rag:${POSTGRES_PASSWORD}@postgres:5432/rag_config
RAG_POSTGRES_ADMIN_URL=postgresql://rag:${POSTGRES_PASSWORD}@postgres:5432/postgres

# ─── Master key API (Bearer admin) ──────────────────────────
RAG_MASTER_KEY=

# ─── URL publique ───────────────────────────────────────────
# Remplacer par l'URL externe de la stack (IP du LXC, FQDN, ou http://localhost en dev).
RAG_PUBLIC_URL=http://localhost

# ─── Harpocrate (résolution secrets ${vault://...}) ────────
# Depuis M5c : coffres configurables exclusivement via l'IHM
# /ui/settings/harpocrate-vaults (ou POST /api/admin/harpocrate-vaults).
#
# HARPOCRATE_DEK : passphrase pgcrypto utilisée pour chiffrer les api_keys
# des coffres en base. Min 32 caractères. OBLIGATOIRE dès qu'un coffre est
# créé via l'IHM ou l'API admin.
# Note docker-compose : doubler tout $ en $$ si déposé via env_file.
HARPOCRATE_DEK=

# ─── Reranking (M8) ──────────────────────────────────────────────────────────
#
# Les clés API des providers de reranking (Cohere / Voyage) sont stockées
# dans Harpocrate, jamais en `.env`. La table `rerank_configs` référence
# une `api_key_ref` (clé logique Harpocrate) par workspace.
#
# Ollama : pas d'api_key, juste un `base_url` (ex. http://localhost:11434).
#
# Aucune variable d'env spécifique au rerank côté serveur — tout est
# configuré via PUT /api/admin/workspaces/{name}/rerank.

# ─── Divers ─────────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO
SYNC_WORKER_POLL_INTERVAL_SECONDS=30

# ─── Sync worker M3 ─────────────────────────────────────────
# Interval défaut entre 2 syncs d'une même source (sec). Override possible
# par source via config.sync_interval_seconds. Min 60s.
SYNC_DEFAULT_INTERVAL_SECONDS=300
# Racine des clones git locaux (volume Docker named en prod).
SYNC_REPOS_ROOT=/var/lib/rag/repos

# ─── Session locale ──────────────────────────────────────────
# TTL session locale en secondes (défaut 28800 = 8h).
RAG_LOCAL_SESSION_TTL_SECONDS=28800

# ─── Réglages d'auth pilotés par l'IHM ───────────────────────
# La désactivation de la connexion locale (RAG_LOCAL_AUTH_DISABLED) et le
# client secret OIDC (RAG_OIDC_CLIENT_SECRET) ne sont PAS ici : ils se
# saisissent dans l'IHM (/ui/settings/oidc-config) et sont persistés dans un
# fichier dédié `admin.env` (relu à chaud, éditable à la main en break-glass).
# Cf. `admin.env.example`. Chemin dans le conteneur : /app/data/admin.env
# (override possible via RAG_ADMIN_ENV_FILE).

# ─── Compte administrateur ───────────────────────────────────
# Créé via le wizard UI au premier accès (/ui/login).
# Aucune variable à renseigner ici — tout passe par l'interface.

# ─── Logs centralisés (Loki / Grafana sur LXC 116) ───────────
# Endpoint push Loki consommé par le conteneur `alloy` (collecteur des logs
# de tous les conteneurs Docker de l'hôte). Vide = Alloy redémarre en boucle
# sans impacter le reste du stack.
LOKI_URL=http://192.168.10.164:3100/loki/api/v1/push
# Label `host` attaché aux logs poussés — identifie cette machine dans Grafana.
# Sert aussi de label `host` sur les métriques (même identité des deux côtés).
LOKI_HOSTNAME=rag-dev

# ─── Métriques ressources (CPU / mémoire / disque) ───────────────────────────
# Endpoint remote-write du backend Prometheus, consommé par le même conteneur
# `alloy`. Cadences : CPU 30 s, mémoire 60 s, espace disque 30 min (définies
# dans deploy/alloy-config.alloy). Vide = aucune historisation des ressources,
# la collecte de logs continue normalement.
METRICS_URL=http://192.168.10.164:9090/api/v1/write
